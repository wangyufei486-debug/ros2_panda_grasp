<?xml version="1.0"?>
<package format="3">
  <name>panda_grasp_ros</name>
  <version>0.1.0</version>
  <description>Publish Panda PyBullet RGB-D images and execute visual grasp actions</description>
  <maintainer email="unknown@example.com">user</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>panda_grasp_interfaces</exec_depend>
  <exec_depend>panda_grasp_perception</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
